---
import { siteConfig } from "../config";

const links = siteConfig.personalLinks;
---

{
  links.length > 0 && (
    <section id="personal-links" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <h2 class="text-3xl font-bold text-gray-900 sm:text-4xl md:text-5xl xl:text-7xl">
            ZBL 自用
          </h2>
          <div
            class="mt-2 h-[5px] w-[75px] rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          />
          <p class="mt-4 text-sm text-gray-600 sm:text-base">我的快捷入口</p>
        </div>

        <div class="grid gap-4 lg:col-span-8 sm:grid-cols-2">
          {links.map((item) => (
            <a
              href={item.link}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex min-h-40 flex-col justify-between rounded-xl border border-gray-200 bg-gray-50 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-gray-300 hover:bg-white hover:shadow-xl sm:rounded-2xl"
            >
              <div class="flex items-start justify-between gap-4">
                <h3 class="text-xl font-bold text-gray-900 sm:text-2xl">{item.name}</h3>
                <span aria-hidden="true" class="text-xl text-gray-700 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
              </div>
              <div>
                <p class="mt-4 text-sm text-gray-600 sm:text-base">{item.description}</p>
                <p class="mt-2 break-all font-mono text-xs" style={`color: ${siteConfig.accentColor}`}>
                  {new URL(item.link).host}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
